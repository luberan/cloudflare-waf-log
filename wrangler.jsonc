{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-waf-log",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
  // Dashboard-defined runtime vars are preserved across Wrangler/Workers Builds deploys by keep_vars.
  // No sensitive values live here — account credentials remain Worker secrets:
  //   For each Cloudflare account create three secrets:
  //     CFACC_<ID>_LABEL    – label shown in the UI dropdown
  //     CFACC_<ID>_ACCOUNT  – Cloudflare Account ID
  //     CFACC_<ID>_TOKEN    – Cloudflare API token (read-only)
  //   Production also requires CF_ACCESS_TEAM_DOMAIN + CF_ACCESS_AUD.
  //   ALLOW_UNAUTHENTICATED_LOCAL_DEV=true belongs only in local .dev.vars and only works on loopback URLs.
  //   Set via:  wrangler secret put CFACC_<ID>_LABEL  (and the other two)
  //   Or in the Cloudflare dashboard → Worker → Settings → Variables and Secrets → Secrets
}
