{
  "name": "cloudflare-waf-log",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "check:frontend": "node --check public/app.js",
    "test": "vitest run",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "check": "npm run typecheck && npm run check:frontend && npm test",
    "check:ci": "npm run check && npm run deploy:dry-run && npm audit --audit-level=high"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "sharp": "^0.35.4"
  }
}
