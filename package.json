{
  "name": "cloudflare-waf-log",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.playwright.json",
    "check:frontend": "node --check public/app.js",
    "check:vendor": "node scripts/vendor-chart.mjs --check",
    "vendor:chart": "node scripts/vendor-chart.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "check": "npm run typecheck && npm run check:frontend && npm run check:vendor && npm test",
    "check:ci": "npm run check && npm run test:browser && npm run deploy:dry-run && npm audit --audit-level=high"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "chart.js": "^4.6.1",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "sharp": "^0.35.4",
    "undici@^7.0.0": "^7.30.1"
  }
}
